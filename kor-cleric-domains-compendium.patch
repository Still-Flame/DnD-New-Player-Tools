From 714d5bc919c89b65d9c32b70189549dc786babdb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 25 Nov 2026 09:08:17 +0530
Subject: [PATCH] Add Kor cleric domains to the Subclass Compendium

Adds two homebrew domains under a new "Homebrew domains (Kor)" group on the
Cleric page: the Compact Domain (Kethrael) with Offer Terms, Many Hands and
Fine Print, and the Domain of Reflection (Mirovenn) with Weigh the Futures,
The Unchosen Future and Hall of Reflections. Adds two glossary terms,
Compact and Reflected.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BvDjneeUiWjaSpQra5D56P
---
 public/compendium/data.js | 41 +++++++++++++++++++++++++++++++++++++++
 src/compendium/data.js    | 41 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 82 insertions(+)

diff --git a/public/compendium/data.js b/public/compendium/data.js
index 01229d0..55fe337 100644
--- a/public/compendium/data.js
+++ b/public/compendium/data.js
@@ -8852,5 +8852,46 @@ CLASSES.warlock.groups.push({ homebrew:true, label:"Homebrew patrons (Craft and
 CLASSES.wizard.groups.push({ homebrew:true, label:"Homebrew traditions (Craft and Creation)",
   keys:["wi-creation","wi-unknown"] });
 
+/* ---------------- Cleric: Kor homebrew domains ---------------- */
+TERMS.compact = {n:"Compact",s:"cleric",d:"A bargain sealed with Offer Terms: each side swears one term from a fixed list. Break yours and your Hit Point maximum drops until you make good. The Compact Domain's whole kit is built on it."};
+TERMS.reflected = {n:"Reflected",s:"cleric",d:"A condition from the Domain of Reflection's top feature. The cleric can flip a Reflected creature's d20 to the opposite face, so a 1 becomes a 20 and a 20 becomes a 1."};
+
+ENTRIES["cl-kor-compact"] = { cls:"cleric", nav:"Compact Domain", navSub:"Levels 3 · 6 · 17", kicker:"Cleric domain · homebrew",
+  name:"Compact Domain", tag:"Seal a bargain, and bury a clause in the fine print",
+  flavor:"The domain of Kethrael, goddess of binding words, contracts and oaths. Her temples enforce the wording of a contract and never its fairness, and her clerics do the same. They swear terms with friends and enemies alike, then summon a swarm of spectral hands to draft the paperwork and to hit things.",
+  src:"Original homebrew (Dhruv Ravikumar), Kor setting",
+  mods:{
+    channeldivinity:"Offer Terms is the domain's use of it. One use seals a Compact, or several once Many Hands is out.",
+    hitpoints:"Breaking a term costs the breaker Hit Point maximum, not Hit Points, so ordinary healing can't mend it.",
+    savingthrow:"Many Hands' strikes leave a −1 penalty on the target's next saving throw, and Fine Print's Waiver clause gives Disadvantage on a save.",
+    reaction:"Liability, one of the Fine Print clauses, is a reaction to you taking damage."
+  },
+  features:[
+    {lvl:"Level 3",name:"Domain Spells",body:"<p>Always {{preparedspells|prepared}}, outside your limit: <em>command</em>, <em>sanctuary</em>, <em>warding bond</em> and <em>zone of truth</em>; <em>bestow curse</em>, <em>counterspell</em>, <em>nondetection</em> and <em>speak with dead</em>; <em>banishment</em>, <em>compulsion</em>, <em>death ward</em> and <em>locate creature</em>; <em>dispel evil and good</em>, <em>geas</em>, <em>hold monster</em> and <em>legend lore</em>.</p>"},
+    {lvl:"Level 3",name:"Channel Divinity: Offer Terms",body:"<p>As a {{magicaction}} and a use of {{channeldivinity}}, choose a creature within 30 feet that can hear and understand you. You pick one term from the table below for it to keep, and it picks one for you. It can accept or refuse, and refusing costs it nothing. If it accepts, the {{compact|Compact}} is sealed for 1 hour. You can have only one Compact sealed at a time.</p><p><b>No Harm.</b> Not deal damage to the other party or make attack rolls against it.</p><p><b>Speak True.</b> Not knowingly say anything false to the other party.</p><p><b>Hold Silence.</b> Not speak of one subject, named when the term is chosen, to anyone.</p><p><b>Stay Close.</b> Stay within 30 feet of the other party.</p><p><b>Keep Place.</b> Not move more than 60 feet from the spot where the Compact was sealed.</p><p><b>Run the Errand.</b> Carry one named object or message to one named creature or place within 1 mile, and finish before the Compact ends.</p><p>You always know the moment either party breaks its term, at any distance on the same plane. A party that breaks its term has its {{hitpoints|Hit Point}} maximum reduced by twice your Cleric level, and the Compact ends. The reduction lasts until the party makes good on the term, or until <em>greater restoration</em> or a Kethrael temple lifts it. A party that finishes Run the Errand has kept its term, and the Compact ends with no penalty. A term isn't broken by something the party couldn't choose, such as being forced to move.</p>"},
+    {lvl:"Level 6",name:"Many Hands",body:"<p>As a {{bonusaction}}, you summon a swarm of spectral hands, each holding a pen, a wax seal or a rubber stamp. Use this once per {{longrest|long rest}}, or by expending a use of {{channeldivinity}}. You manifest a number of hands equal to your {{proficiencybonus|Proficiency Bonus}} for 1 minute. They hover within 10 feet of you, move when you move, and can't be targeted or harmed. They vanish early if you are {{incapacitated|Incapacitated}} or die. Each hand is either busy or free.</p><p><b>Draft.</b> A hand can hold one {{compact|Compact}}. While the hands are out, Offer Terms can seal a separate Compact with a different creature for each hand, up to your Proficiency Bonus. Each has its own terms, its own penalty and its own end. A hand holding a Compact is busy and can't strike.</p><p><b>Strike.</b> When you take the Attack action on your turn, you can replace one attack with a flurry from your free hands. Each free hand makes a melee spell attack against a creature within 30 feet, dealing 1d4 force damage on a hit. A hand that hits slaps a signed contract on the target, which takes a −1 penalty to its next {{savingthrow|saving throw}}. The penalty doesn't stack.</p>"},
+    {lvl:"Level 17",name:"Fine Print",body:"<p>When you seal a {{compact|Compact}} with Offer Terms, you can write one Clause on it. Choose the Clause from the table and write it down secretly. The other party doesn't see it. When it accepts, it must succeed on an Intelligence (Investigation) check against your spell save DC to read the fine print. On a success, it sees the Clause and can still refuse. On a failure, it accepts without knowing what it signed. Each Clause fires once, then it's spent.</p><p><b>Liability</b> ({{reaction|Reaction}}, when you take damage). The bound creature takes damage equal to half of what you took. Resistances don't apply.</p><p><b>Waiver</b> (when you cast a spell that forces the bound creature to make a saving throw). It has {{disadvantage|Disadvantage}} on the save and can't use Legendary Resistance or similar features to pass it.</p><p><b>Automatic Renewal</b> (when the Compact would end because time runs out or the term is finished). It renews for another hour with the same terms, and the creature doesn't get to agree again.</p><p><b>Amendment</b> ({{bonusaction|Bonus Action}}). You change the bound creature's term to a different term from the list. It gets no say.</p><p><b>Fee</b> (when the bound creature breaks its term). It owes you 25 gp × your Cleric level. Until it pays, the Hit Point maximum reduction from the breach can't be lifted by magic.</p><p>A bound creature can look for the fine print later by taking an action to repeat the Investigation check. On a success, it reads the Clause and the Clause is voided.</p>"}
+  ]};
+
+ENTRIES["cl-kor-reflection"] = { cls:"cleric", nav:"Domain of Reflection", navSub:"Levels 3 · 6 · 17", kicker:"Cleric domain · homebrew",
+  name:"Domain of Reflection", tag:"Show them two futures, and make them pay for the one they pass over",
+  flavor:"The domain of Mirovenn, god of magic, weight and reflection. His clerics practise the Inner Mirror and the nightly Reckoning. In a fight they hold up two ways the next moment can go, and the dice decide who else has to live with the one nobody picked.",
+  src:"Original homebrew (Dhruv Ravikumar), Kor setting",
+  mods:{
+    channeldivinity:"Weigh the Futures is the domain's use of it. It forces a creature to choose between losing its movement and losing its action.",
+    savingthrow:"The Unchosen Future calls for a Wisdom save, and a success only halves the future.",
+    d20test:"Hall of Reflections can flip any d20 Test a Reflected creature makes: the result becomes 21 minus the roll.",
+    speed:"Stand Still sets Speed to 0 for a turn, and a half version just halves it."
+  },
+  features:[
+    {lvl:"Level 3",name:"Domain Spells",body:"<p>Always {{preparedspells|prepared}}, outside your limit: <em>augury</em>, <em>detect thoughts</em>, <em>mirror image</em> and <em>shield</em>; <em>clairvoyance</em>, <em>counterspell</em>, <em>dispel magic</em> and <em>slow</em>; <em>arcane eye</em>, <em>banishment</em>, <em>divination</em> and <em>locate creature</em>; <em>hold monster</em>, <em>legend lore</em>, <em>modify memory</em> and <em>scrying</em>.</p>"},
+    {lvl:"Level 3",name:"Channel Divinity: Weigh the Futures",body:"<p>As a {{magicaction}} and a use of {{channeldivinity}}, choose a creature you can see within 60 feet. It makes a Wisdom {{savingthrow|saving throw}}. On a failure, you show it two futures, and at the start of its next turn it must choose one:</p><p><b>Stand Still.</b> Its {{speed|Speed}} is 0 until the end of that turn.</p><p><b>Lose the Moment.</b> It can't take actions or Bonus Actions until the end of that turn.</p><p>On a success, nothing happens.</p>"},
+    {lvl:"Level 6",name:"The Unchosen Future",body:"<p>When a creature chooses a future from Weigh the Futures, choose up to a number of other creatures equal to your {{proficiencybonus|Proficiency Bonus}} that you can see within 30 feet of it, and roll a d6 for each one. On a 1–3, the future passes it by. On a 4 or 5, it must make a Wisdom {{savingthrow|saving throw}} against your spell save DC at the start of its next turn. On a 6, it makes that save twice, once for each future.</p><p>On a failed save, the creature suffers the future in full. On a success, it suffers a half version. <b>Stand Still, halved:</b> its Speed is halved until the end of its turn. <b>Lose the Moment, halved:</b> it can take an action or a Bonus Action that turn, but not both.</p><p><b>Reflected Die.</b> After you roll, you can reflect one die so it shows the opposite face (7 minus the roll). You can do this a number of times equal to your Wisdom modifier (minimum once), and you regain all expended uses when you finish a {{longrest|Long Rest}}.</p>"},
+    {lvl:"Level 17",name:"Hall of Reflections",body:"<p>Once per {{longrest|Long Rest}}, as a {{magicaction}}, choose up to a number of creatures equal to your {{proficiencybonus|Proficiency Bonus}} that you can see within 60 feet. A willing creature needs no save. Any other creature makes a Wisdom {{savingthrow|saving throw}}, and a successful save leaves it unaffected. Each affected creature becomes {{reflected|Reflected}} for 1 minute.</p><p>Whenever a Reflected creature makes a {{d20test|D20 Test}}, you can reflect the roll. This takes no action, and you can do it once per round per Reflected creature, after the roll and before the outcome is known. The d20 shows the opposite face, so the result becomes 21 minus the roll. A natural 1 becomes a natural 20, and a natural 20 becomes a natural 1.</p><p>When you reflect a natural 1 or a natural 20, you regain one expended use of Reflected Die.</p>"}
+  ]};
+
+CLASSES.cleric.groups.push({ homebrew:true, label:"Homebrew domains (Kor)",
+  keys:["cl-kor-compact","cl-kor-reflection"] });
+
 /* ==APPEND CLASSES ABOVE THIS LINE== */
 })();
