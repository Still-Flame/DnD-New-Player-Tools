 ENTRIES["cm-ax-medic"] = {"cls":"commando","nav":"Field medic bastion","navSub":"10 options","kicker":"Armoury axis","name":"Field Medic Bastion","tag":"Patching people up while holding the ground","flavor":"Healing, stabilising and standing in the way. These options keep a squad on its feet through a long fight.","src":"The Commando (original homebrew), Armoury Options","mods":{},"features":[{"lvl":"No cost","name":"Bastion Aura","body":"<p><em>Medic, Doctrine.</em></p><p>Allies within 10 feet of you add your Intelligence modifier (minimum of 1) to death saving throws and to Constitution saving throws made to maintain Concentration.</p>"},{"lvl":"1 Edge die","name":"Combat Stimulant","body":"<p><em>Medic, Gadget.</em></p><p>As a Bonus Action, touch an ally. Until the start of your next turn, the ally's Speed increases by 10 feet and it can take the Dash action as a Bonus Action.</p>"},{"lvl":"1 Edge die","name":"Cover the Wounded","body":"<p><em>Medic, Technique.</em></p><p>When a creature within 10 feet of you targets an ally that has half its Hit Points or fewer with an attack, you can take a Reaction to move up to 15 feet without provoking Opportunity Attacks, ending adjacent to the ally. The attack roll has Disadvantage.</p>"},{"lvl":"Uses","name":"Field Dressing Kit","body":"<p><em>Medic, Gadget.</em></p><p>As an Action, touch a creature. It regains 2d6 plus your Intelligence modifier Hit Points (3d6 at level 11, 4d6 at level 17), and you end the Poisoned condition on it or one effect on it that deals ongoing damage.</p>"},{"lvl":"No cost","name":"Hold the Line","body":"<p><em>Medic, Doctrine.</em></p><p>Allies within 10 feet of you have Advantage on saving throws against the Frightened condition and against forced movement.</p>"},{"lvl":"2 Edge dice","name":"Rally Point","body":"<p><em>Medic, Doctrine.</em> Requires level 5.</p><p>As an Action, roll both dice. Allies of your choice within 30 feet who can hear you gain Temporary Hit Points equal to the total plus your Commando level.</p>"},{"lvl":"2 Edge dice","name":"Revive","body":"<p><em>Medic, Technique.</em> Requires level 5.</p><p>As an Action, touch a creature that has 0 Hit Points and isn't dead. Roll both dice. It regains Hit Points equal to the total plus your Intelligence modifier and can stand up as part of its next move.</p>"},{"lvl":"Uses","name":"Smelling Salts","body":"<p><em>Medic, Gadget.</em></p><p>As an Action, touch a creature. You end one of the following conditions on it: Unconscious (if not caused by damage), Charmed, or Deafened.</p>"},{"lvl":"No cost","name":"Stabilise","body":"<p><em>Medic, Technique.</em></p><p>As a Bonus Action, you stabilize a creature with 0 Hit Points within 5 feet of you. No check is required.</p>"},{"lvl":"No cost","name":"Triage","body":"<p><em>Medic, Doctrine.</em></p><p>You always know the current Hit Points of allies within 60 feet. When you restore Hit Points to an ally that has half its Hit Points or fewer, add your Intelligence modifier (minimum of 1) to the amount.</p>"}]};
 ENTRIES["cm-ax-breaker"] = {"cls":"commando","nav":"Two-handed breaker","navSub":"10 options","kicker":"Armoury axis","name":"Two-Handed Breaker","tag":"Heavy weapons and heavier blows","flavor":"Great weapons, bigger swings and crowd-clearing sweeps. They work only with a melee weapon that has the Heavy or Two-Handed property. These options work only with a melee weapon that has the Heavy or Two-Handed property.","src":"The Commando (original homebrew), Armoury Options","mods":{},"features":[{"lvl":"1 Edge die","name":"Breaking Guard","body":"<p><em>Two-Handed, Technique.</em></p><p>When you hit a creature, add the die to the damage. The target loses the Armor Class bonus from any Shield it wields until the end of its next turn.</p>"},{"lvl":"1 Edge die","name":"Cleave Through","body":"<p><em>Two-Handed, Technique.</em></p><p>Once per turn, when you reduce a creature to 0 Hit Points, you can make one more melee attack against a different creature within your reach.</p>"},{"lvl":"No cost","name":"Committed Swing","body":"<p><em>Two-Handed, Technique.</em></p><p>Before you make an attack roll, you can take a -3 penalty to it. If the attack hits, it deals an extra 6 damage.</p>"},{"lvl":"No cost","name":"Heavy Hands","body":"<p><em>Two-Handed, Technique.</em></p><p>Your attacks with such a weapon ignore Resistance to Bludgeoning, Piercing, and Slashing damage from nonmagical sources.</p>"},{"lvl":"No cost","name":"Keep Them Out","body":"<p><em>Two-Handed, Technique.</em></p><p>You can make an Opportunity Attack against a creature that enters your reach. On a hit, the creature's Speed is 0 for the rest of that movement.</p>"},{"lvl":"No cost","name":"Lasting Wound","body":"<p><em>Two-Handed, Technique.</em></p><p>Once per turn, when you hit a creature, it can't regain Hit Points until the start of your next turn.</p>"},{"lvl":"No cost","name":"Momentum","body":"<p><em>Two-Handed, Technique.</em></p><p>Once per turn, when you hit a creature after hitting a different creature earlier in the same turn, add your Proficiency Bonus to the damage.</p>"},{"lvl":"1 Edge die","name":"Overhead Smash","body":"<p><em>Two-Handed, Technique.</em></p><p>When you hit a creature, add the die to the damage. If the target is Large or smaller, it must succeed on a Strength saving throw or have the Prone condition.</p>"},{"lvl":"2 Edge dice","name":"Sweeping Cleave","body":"<p><em>Two-Handed, Technique.</em> Requires level 5.</p><p>As an Action, make one attack roll and compare it to the Armor Class of every creature within your reach. Roll both dice and choose one. Each creature you hit takes the weapon's damage plus extra damage equal to the chosen die.</p>"},{"lvl":"1 Edge die","name":"Unbalance","body":"<p><em>Two-Handed, Technique.</em></p><p>When you hit a creature, add the die to the damage. The target has Disadvantage on the next saving throw it makes before the end of your next turn.</p>"}]};
 
