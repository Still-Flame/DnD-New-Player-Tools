":"Medium Rounds","dmg":"2d8 or 1d12","cost":"16 gp per 20","txt":"8 sp each.","w":0,"gp":16.0},{"src":"retia","page":518,"type":"Ammunition","cat":"Firearm Ammunition","name":"Heavy Rounds","dmg":"2d10","cost":"20 gp per 20","txt":"1 gp each.","w":0,"gp":20.0},{"src":"retia","page":518,"type":"Ammunition","cat":"Firearm Ammunition","name":"Buck Charge","dmg":"4d10","cost":"25 gp per 5","txt":"5 gp each.","w":0,"gp":25.0},{"src":"retia","page":518,"type":"Ammunition","cat":"Firearm Ammunition","name":"Explosive Round","dmg":"4d12","cost":"50 gp per 5","txt":"10 gp each.","w":0,"gp":50.0},{"src":"kor","type":"Weapon","cat":"Trick Weapon","name":"Pin-Edge Falchion","house":"House Stahlmark","axis":"Proof (control the exchange)","dmg":"1d6 Slashing / 1d8 Slashing","forms":[{"n":"Blackened Edge","dmg":"1d6 Slashing","props":"Finesse, Light"},{"n":"Silvered Edge","dmg":"1d8 Slashing","props":"Versatile (1d10), counts as silvered"}],"swap":{"n":"Pin","t":"After a hit, the target makes a Constitution save. On a failure it can't change form or stance until the start of its next turn. This includes shapechanging and monster features that swap its state."},"cost":"250 gp","txt":"The silvered edge is built in, which is the reason for the price. The Pin save counters Sanctumbra's instant light and shadow swaps.","w":0,"gp":250},{"src":"kor","type":"Weapon","cat":"Trick Weapon","name":"Rifle-Spear","house":"House Stahlmark","axis":"Proof (control the exchange)","dmg":"1d6 Piercing / 1d10 Piercing","forms":[{"n":"Spear","dmg":"1d6 Piercing","props":"Versatile (1d8)"},{"n":"Rifle","dmg":"1d10 Piercing","props":"Ammunition (40/120), Loading, Two-Handed"}],"swap":{"n":"Prime","t":"Fires on the swap into Spear. After you hit, your next Rifle hit before the end of your next turn deals an extra 1d6 Piercing."},"cost":"250 gp","cons":"Plus bullets","w":0,"gp":250},{"src":"kor","type":"Weapon","cat":"Trick Weapon","name":"Plate-Halberd","house":"House Stahlmark","axis":"Proof (control the exchange)","dmg":"1d6 Bludgeoning / 1d10 Slashing","forms":[{"n":"Tower Plate","dmg":"1d6 Bludgeoning","props":"+2 AC while held"},{"n":"Halberd","dmg":"1d10 Slashing","props":"Heavy, Reach, Two-Handed"}],"swap":{"n":"Anchor","t":"On swap. Until the start of your next turn, you can't be moved against your will or knocked Prone."},"cost":"200 gp","w":0,"gp":200},{"src":"kor","type":"Weapon","cat":"Trick Weapon","name":"Quenchblade","house":"House Karzeval","axis":"Compound (spend vials for effects)","dmg":"1d6 Slashing / 1d10 Slashing","forms":[{"n":"Hatchet","dmg":"1d6 Slashing","props":"Light; 3 lb"},{"n":"Glaive","dmg":"1d10 Slashing","props":"Heavy, Reach, Two-Handed; 6 lb"}],"swap":{"n":"Quench","t":"If you swap with at least one vial in the haft, the swap spends one. Your first hit that turn deals an extra 1d6 Cold damage, and any nonmagical fire burning on the target goes out."},"cost":"200 gp","cons":"Vials 5 gp","txt":"Reservoir. The haft holds up to three Quench vials. You refill one with the Utilize action.\n\nPour. As a Utilize action, you can spend a vial to put out nonmagical fire in a 5-foot square within reach.\n\nWhy it works against the WyldHunts families. The Cold rider ends Brand with no extra text, because Brand already ends on Cold damage from a non-Brimfrost source. It breaks a cracked Slagbrood plate, because a Cold hit already does that. Pour handles the Slag Torrent line, which burns until doused. The weapon only calls on existing monster rules.","w":0,"gp":200},{"src":"kor","type":"Weapon","cat":"Trick Weapon","name":"Cylinder-Mace","house":"House Karzeval","axis":"Compound (spend vials for effects)","dmg":"1d6 Bludgeoning / 1d8 Piercing","forms":[{"n":"Mace","dmg":"1d6 Bludgeoning"},{"n":"Morningstar","dmg":"1d8 Piercing"}],"swap":{"n":"Compound","t":"The cylinder holds three vials. A swap spends the vial in the chamber and advances to the next one. A hit deals an extra 1d6 damage of that vial's type (Acid, Cold, Fire or Poison), but only if that type differs from the vial you spent on your previous swap. The first swap after loading always counts."},"cost":"200 gp","cons":"Vials 10 gp","txt":"The type-change trigger rewards loading a mixed cylinder, which fits the Compound axis.","w":0,"gp":200},{"src":"kor","type":"Weapon","cat":"Trick Weapon","name":"Antidote Lancet-Lance","house":"House Karzeval","axis":"Compound (spend vials for effects)","dmg":"1d4 Piercing / 1d10 Piercing","forms":[{"n":"Lancet","dmg":"1d4 Piercing","props":"Finesse, Light"},{"n":"Lance","dmg":"1d10 Piercing","props":"Heavy, Reach, Two-Handed (unless mounted)"}],"swap":{"n":"Inoculate","t":"Support delivery, fires on the swap into Lancet. Spend one Antidote vial and touch a willing creature. Until the start of your next turn, the first time it fails a saving throw against poison or disease, it can reroll the save and take the new result."},"cost":"200 gp","cons":"Vial 25 gp","w":0,"gp":200},{"src":"kor","type":"Weapon","cat":"Trick Weapon","name":"Flare-Axe","house":"House Volkhard","axis":"Wall (hold ground and signal)","dmg":"1d6 Slashing / 1d10 Slashing","forms":[{"n":"Handaxe","dmg":"1d6 Slashing","props":"Light, Thrown (Range 20/60)"},{"n":"Halberd","dmg":"1d10 Slashing","props":"Heavy, Reach, Two-Handed"}],"swap":{"n":"Flare Strike","t":"Spend one flare (the haft holds two). A hit lodges it in the target, which sheds Bright Light in a 30-ft radius for 1 minute. As a Utilize action you can also fire a flare straight up, visible for a mile."},"cost":"200 gp","cons":"Flare 5 gp","txt":"The Bright Light suppresses Gloamkin Shadowmark through the existing rule, so the weapon adds no monster text.","w":0,"gp":200},{"src":"kor","type":"Weapon","cat":"Trick Weapon","name":"Horn-Spear","house":"House Volkhard","axis":"Wall (hold ground and signal)","dmg":"1d6 Piercing / 1d10 Piercing","forms":[{"n":"Spear","dmg":"1d6 Piercing","props":"Versatile (1d8)"},{"n":"Pike","dmg":"1d10 Piercing","props":"Heavy, Reach, Two-Handed"}],"swa